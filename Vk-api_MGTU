import requests # библиотка для HTTP-запросов
from datetime import datetime, timezone # библиотека для преобразования числа формата unixtime в дата/время
import time # библиотека для получения текущего года
import pandas # библиотека для сохранения результата запроса в Excel-файл
from google.colab import files # библиотка для скачивания файлов
ACCESS_TOKEN = "63cbfa7863cbfa7863cbfa78cd608fd569663cb63cbfa7809754abee24b2edd2378a7e1" #Сервисный токен доступа
VK_GROUPS = ['https://vk.ru/nmstu',
            'https://vk.ru/pkmagtu',
            'https://vk.ru/pravokatormstu',
            'https://vk.ru/cathbiit',
            'https://vk.ru/ieias_mgtu']  # Сообщества ВК
API_VERSION = "5.199" #Выбираем последнюю версию апи-вк

def get_group_posts(group_id, count=100, offset=0):
    url = "https://api.vk.com/method/wall.get"
    params = {
        "owner_id": group_id,
        "count": count,
        "offset": offset,
        "filter": "owner",  # только посты сообщества
        "access_token": ACCESS_TOKEN,
        "v": API_VERSION
    }
    response = requests.get(url, params=params)
    data = response.json()

    if "error" in data:
        print(f"Ошибка: {data['error']['error_msg']}")
        return []

    return data["response"]["items"]

def get_posts_by_this_year(group_id):
    all_posts = []
    offset = 0
    count = 100
    checker = False;
    while True:
        posts = get_group_posts(group_id, count=count, offset=offset)
        if not posts or checker:
            break
        for post in posts:
            if int(datetime.fromtimestamp(post['date'], tz=timezone.utc).strftime('%Y')) == datetime.now().year: # Проверка постов по дате на текущий год
                all_posts.append(post)
            else:
                checker = True;
        offset += count

        # Небольшая задержка, чтобы не превысить лимиты
        time.sleep(0.34)  # ~3 запроса в секунду

    return all_posts

# Получение всех постов за текущий год с групп вк, связанных с МГТУ
rows = []
for group in VK_GROUPS:
    posts = get_posts_by_this_year(group.removeprefix('https://vk.ru/'))
    rows.extend([{"Пост": post['text'], "Ссылка": group} for post in posts])
dataframe = pandas.DataFrame(rows)
dataframe.to_excel("result.xlsx", index=False)
files.download("result.xlsx")

